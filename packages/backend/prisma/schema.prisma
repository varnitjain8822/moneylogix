generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String
  name               String
  phone              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  watchlists         Watchlist[]
  portfolios         Portfolio[]
  trades             Trade[]
  alerts             Alert[]
  strategies         Strategy[]
  chatSessions       ChatSession[]
  paperWallet        PaperWallet?
  paperOrders        PaperOrder[]
  riskProfile        RiskProfile?
  achievements       UserAchievement[]
  tradeNotes         TradeNote[]
  portfolioHistory   PortfolioHistory[]
}

model Watchlist {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  symbols   WatchlistSymbol[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WatchlistSymbol {
  id          String    @id @default(cuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id])
  symbol      String
  addedAt     DateTime  @default(now())
  @@unique([watchlistId, symbol])
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  symbol    String
  type      AlertType
  value     Float
  triggered Boolean  @default(false)
  message   String?
  createdAt DateTime @default(now())
  triggeredAt DateTime?
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  PERCENT_UP
  PERCENT_DOWN
  FIFTY_TWO_WEEK_HIGH
  FIFTY_TWO_WEEK_LOW
  RSI_OVERBOUGHT
  RSI_OVERSOLD
}

model Portfolio {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  holdings  Holding[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Holding {
  id           String    @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id])
  symbol       String
  quantity     Int
  avgPrice     Float
  currentPrice Float
  sector       String?
  assetClass   String?
  buyDate      DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Trade {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  symbol    String
  type      TradeType
  quantity  Int
  price     Float
  total     Float
  status    TradeStatus @default(EXECUTED)
  strategy  String?
  notes     String?
  createdAt DateTime  @default(now())
}

enum TradeType {
  BUY
  SELL
}

enum TradeStatus {
  PENDING
  EXECUTED
  CANCELLED
  REJECTED
}

model PaperOrder {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  symbol      String
  type        OrderType
  side        OrderSide
  quantity    Int
  price       Float?
  stopPrice   Float?
  filledQty   Int         @default(0)
  filledPrice Float?
  totalCost   Float?
  fees        Float       @default(0)
  status      OrderStatus @default(PENDING)
  reason      String?
  strategy    String?
  notes       String?
  createdAt   DateTime    @default(now())
  filledAt    DateTime?
  updatedAt   DateTime    @updatedAt
  orderFills  OrderFill[]
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LOSS
  STOP_LIMIT
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

model OrderFill {
  id        String   @id @default(cuid())
  orderId   String
  order     PaperOrder @relation(fields: [orderId], references: [id])
  quantity  Int
  price     Float
  total     Float
  fees      Float    @default(0)
  createdAt DateTime @default(now())
}

model PaperPosition {
  id         String      @id @default(cuid())
  walletId   String
  wallet     PaperWallet @relation(fields: [walletId], references: [id])
  symbol     String
  quantity   Int
  avgPrice   Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model PaperWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Float    @default(1000000)
  positions PaperPosition[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioHistory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  totalValue    Float
  cash          Float
  holdingsValue Float
  pnl           Float
  pnlPercent    Float
  dayPnl        Float
  dayPnlPercent Float
  createdAt     DateTime @default(now())
}

model RiskProfile {
  id                String @id @default(cuid())
  userId            String @unique
  user              User   @relation(fields: [userId], references: [id])
  riskAppetite      RiskAppetite
  investmentHorizon Int?
  monthlyIncome     Float?
  riskToleranceScore Int?
  goals             Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum RiskAppetite {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
}

model Strategy {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  name            String
  description     String?
  rules           Json
  riskAppetite    RiskAppetite
  status          StrategyStatus   @default(DRAFT)
  backtestRuns    BacktestResult[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      ChatType
  messages  ChatMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChatType {
  AI_ADVISOR
  RESEARCH
  TRADE_COACH
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id])
  role      MessageRole
  content   String
  sources   Json?
  createdAt DateTime    @default(now())
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model NewsItem {
  id            String   @id @default(cuid())
  title         String
  content       String?
  source        String
  url           String
  sentiment     Float?
  sentimentLabel String?
  symbols       String[]
  publishedAt   DateTime
  createdAt     DateTime @default(now())
}

model BacktestResult {
  id          String   @id @default(cuid())
  strategyId  String
  strategy    Strategy @relation(fields: [strategyId], references: [id])
  startDate   DateTime
  endDate     DateTime
  totalReturn Float
  sharpeRatio Float?
  maxDrawdown Float?
  winRate     Float?
  trades      Json
  equityCurve Json
  createdAt   DateTime @default(now())
}

model Achievement {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  category    String
  createdAt   DateTime @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId])
}

model TradeNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tradeId   String?
  symbol    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
